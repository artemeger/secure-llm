# Copy to .env and adjust. .env is gitignored.

# Host directory mounted into the container as /workspace (default ./workspace).
# Point it at your project directory instead of copying files in:
#   WORKSPACE_DIR=/home/<user>/projects/my-project
WORKSPACE_DIR=./workspace

# Machine A's LAN IP — ALSO edit the literal in gateway.conf!
A_LAN_IP=192.168.1.10

# Build-time toolchain (internet only during `docker compose build`).
# See opencode/tools/README.md for available scripts and conventions.
TOOLS=git ripgrep fd ast-grep jq
# JVM project example:
# TOOLS=git ripgrep fd jq java gradle maven
